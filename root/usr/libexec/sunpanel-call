#!/usr/bin/ucode
// luci-app-sunpanel -- CLI dispatcher invoked by LuCI views through
// rpcd `file exec` (fs.exec_direct). Always emits exactly one JSON line.
//
// Usage: sunpanel-call <action> [args...]
// NOTE: this ucode build resolves symbols in textual order (no hoisting):
//       helpers must be declared before first use.
// Configuration storage: /etc/sunpanel.conf (KEY='value').

'use strict';

import { readfile, popen, lsdir, stat, mkdir, open, unlink } from 'fs';

const PLUGIN_VERSION = '1.1.0';
const GITHUB_API = 'https://api.github.com/repos/hslr-s/sun-panel/releases?per_page=100';
const SHARE = '/usr/share/sunpanel';
const CONF_FILE = '/etc/sunpanel.conf';

function sq(s) {
	return "'" + replace(s, "'", "'\\''") + "'";
}

function sh_out(cmd) {
	let p = popen(cmd, 'r');
	if (!p)
		return null;
	let d = p.read('all');
	p.close();
	return (d == null) ? null : d;
}

function sh_bg(cmd) {
	// cmd is composed from sq()-escaped parts; do NOT re-quote as a whole.
	// busybox here has no nohup: detach with setsid (survives popen close
	// and ssh session exit).
	popen('setsid ' + cmd + ' </dev/null >/dev/null 2>&1 &', 'r')?.close();
}

function mkdir_p(path) {
	sh_out('mkdir -p ' + sq(path));
}

function read_kv(path) {
	let o = {};
	let txt = readfile(path);
	if (txt == null)
		return o;
	let lines = split(trim(txt), '\n');
	for (let i = 0; i < length(lines); i++) {
		let line = lines[i];
		if (line == '' || substr(line, 0, 1) == '#')
			continue;
		let p = split(line, '=');
		if (length(p) >= 2)
			o[p[0]] = join('=', slice(p, 1));
	}
	return o;
}

function read_conf() {
	let o = {};
	let txt = readfile(CONF_FILE);
	if (txt == null)
		return o;
	let lines = split(trim(txt), '\n');
	for (let i = 0; i < length(lines); i++) {
		let line = lines[i];
		if (line == '' || substr(line, 0, 1) == '#')
			continue;
		let p = split(line, '=');
		if (length(p) < 2)
			continue;
		let v = join('=', slice(p, 1));
		// strip surrounding single quotes
		if (length(v) >= 2 && substr(v, 0, 1) == "'" && substr(v, length(v) - 1) == "'")
			v = substr(v, 1, length(v) - 2);
		o[p[0]] = v;
	}
	return o;
}

function conf_val(k, def) {
	let v = read_conf()[k];
	return (v == null || v == '') ? def : v;
}

function app_dir() { return conf_val('APP_DIR', '/mnt/mmcblk0p1/sun-panel/app'); }
function data_dir() { return conf_val('DATA_DIR', '/mnt/mmcblk0p1/sun-panel/data'); }
function state_dir() { return app_dir() + '/.state'; }
function sp_port() { return conf_val('PORT', '3002'); }

function installed_version() {
	let v = readfile(app_dir() + '/version');
	return (v == null) ? '' : trim(v);
}

function v2_present() {
	return stat(app_dir() + '/sun-panel') != null;
}

function legacy_dir() {
	let d = conf_val('LEGACY_V1_DIR', '');
	if (d == '')
		return '';
	if (substr(d, 0, 1) != '/')
		d = '/' + d;
	d = replace(d, /\/+$/, '');
	return (readfile(d + '/conf.ini') != null) ? d : '';
}

function running() {
	let p = sh_out('pidof sun-panel 2>/dev/null');
	return (p != null && trim(p) != '');
}

function service_enabled() {
	let p = sh_out('/etc/init.d/sunpanel enabled >/dev/null 2>&1 && echo yes || echo no');
	return trim(p ?? 'no') == 'yes';
}

function goarch() {
	let m = trim(sh_out('uname -m') ?? '');
	switch (m) {
		case 'x86_64': return 'amd64';
		case 'aarch64': return 'arm64';
		default:
			if (index(m, 'armv7') >= 0) return 'armv7';
			return m;
	}
}

function tail_lines(path, n) {
	let p = sh_out(sprintf('tail -n %d %s 2>/dev/null', n, sq(path)));
	return (p == null) ? '' : trim(p);
}

function rj(o) {
	printf('%J\n', o);
}

function err(msg) {
	rj({ ok: false, error: msg });
	exit(1);
}

function act_ping() {
	rj({ ok: true, pong: true, plugin_version: PLUGIN_VERSION });
}

function act_info() {
	let app = app_dir();
	let rel = app + '/releases';
	let releases = [];
	let names = lsdir(rel) ?? [];
	for (let i = 0; i < length(names); i++) {
		let n = names[i];
		let st = stat(rel + '/' + n + '/sun-panel');
		if (st == null)
			continue;
		push(releases, { version: n, size: st.size, mtime: st.mtime });
	}
	let legacy = legacy_dir();
	let mode;
	if (v2_present())
		mode = 'v2';
	else if (legacy != '')
		mode = 'legacy';
	else
		mode = 'none';

	let legacy_ver = trim(readfile('/usr/share/sunpanel/version') ?? '');
	let ver = (mode == 'v2') ? installed_version() : legacy_ver;

	rj({
		ok: true,
		plugin_version: PLUGIN_VERSION,
		mode: mode,
		running: running(),
		service_enabled: service_enabled(),
		port: sp_port(),
		installed_version: ver,
		app_dir: app,
		data_dir: data_dir(),
		releases: releases,
		legacy: {
			dir: legacy,
			binary: (stat('/usr/sbin/sun-panel') != null),
			version_file: legacy_ver
		},
		channel: conf_val('CHANNEL', 'beta'),
		mirror: conf_val('MIRROR', ''),
		proxy_set: conf_val('PROXY', '') != '',
		proxy: conf_val('PROXY', ''),
		arch: goarch()
	});
}

function act_check_update() {
	let proxy = conf_val('PROXY', '');
	let cmd = sprintf('curl -fsS -m 25 -A %s %s %s',
		sq('luci-app-sunpanel/' + PLUGIN_VERSION),
		(proxy != '') ? '-x ' + sq(proxy) : '',
		sq(GITHUB_API));
	let out = sh_out(cmd);
	if (out == null || trim(out) == '')
		err('GitHub API unreachable (network, mirror or proxy issue)');

	let rels;
	try {
		rels = json(out);
	} catch (e) {
		err('GitHub API response parse failed');
	}
	if (type(rels) != 'array')
		err('GitHub API returned unexpected payload');

	let arch = goarch();
	let stable = null, beta = null;
	let stable_list = [], beta_list = [];
	let suffix = '_linux_' + arch + '.tar.gz';
	for (let i = 0; i < length(rels); i++) {
		let r = rels[i];
		let tag = r.tag_name;
		// match by pattern, not exact tag: upstream renamed tags
		// (release v2.0.2-beta.5 ships assets named ...beta261118...)
		let asset = null;
		for (let j = 0; j < length(r.assets); j++) {
			let n = lc(r.assets[j].name);
			if (substr(n, 0, 10) == 'sun-panel_' && substr(n, length(n) - length(suffix)) == suffix) {
				asset = r.assets[j];
				break;
			}
		}
		if (asset == null)
			continue;
		let e = {
			tag: tag,
			name: (r.name != null && r.name != '') ? r.name : tag,
			prerelease: (r.prerelease == true),
			date: r.published_at,
			url: asset.browser_download_url,
			size: asset.size,
			sha256: null
		};
		if (type(asset.digest) == 'string' && index(asset.digest, 'sha256:') == 0)
			e.sha256 = substr(asset.digest, 7);
		// channel = major version line of the release itself (name first,
		// tag as fallback): v2.* -> V2 list, everything else -> V1 list
		let isV2 = (substr(lc(e.name), 0, 3) == 'v2.') || (substr(lc(tag), 0, 3) == 'v2.');
		if (isV2) {
			if (beta == null)
				beta = e;
			if (length(beta_list) < 30)
				push(beta_list, e);
		}
		else if (!e.prerelease) {
			if (stable == null)
				stable = e;
			if (length(stable_list) < 30)
				push(stable_list, e);
		}
	}
	rj({ ok: true, current: installed_version(), arch: arch, stable: stable, beta: beta,
		stable_list: stable_list, beta_list: beta_list });
}

function act_update_start() {
	let tag = ARGV[1], url = ARGV[2], sha = ARGV[3];
	if (tag == null || url == null)
		err('missing tag/url');
	mkdir_p(state_dir());
	sh_bg(sprintf('sh %s/update.sh download-install %s %s %s',
		SHARE, sq(tag), sq(url), (sha == null) ? '-' : sq(sha)));
	rj({ ok: true, started: true });
}

function act_update_status() {
	let st = read_kv(state_dir() + '/update.state');
	st.ok = (st.ok != null) ? int(st.ok) : null;
	st.log = tail_lines(state_dir() + '/update.log', 20);
	rj({ ok: true, state: st });
}

function act_release_import() {
	let src = ARGV[1];
	if (src == null || stat(src) == null)
		err('uploaded release file not found');
	mkdir_p(state_dir());
	sh_bg(sprintf('sh %s/update.sh import %s', SHARE, sq(src)));
	rj({ ok: true, started: true });
}

function act_rollback() {
	let ver = ARGV[1];
	if (ver == null)
		err('missing version');
	mkdir_p(state_dir());
	sh_bg(sprintf('sh %s/update.sh rollback %s', SHARE, sq(ver)));
	rj({ ok: true, started: true });
}

function act_release_delete() {
	let ver = ARGV[1];
	if (ver == null || index(ver, '/') >= 0 || index(ver, '..') >= 0)
		err('bad version');
	let out = sh_out(sprintf('sh %s/update.sh delete %s 2>&1', SHARE, sq(ver)));
	if (trim(out ?? '') == 'ok')
		rj({ ok: true });
	else
		err(trim(out ?? 'delete failed'));
}

function act_conf_render() {
	let out = sh_out(sprintf('sh %s/confgen.sh 2>&1', SHARE));
	if (index(out ?? '', 'rendered') >= 0)
		rj({ ok: true, out: trim(out) });
	else
		err(trim(out ?? 'confgen failed'));
}

function act_logs() {
	let name = ARGV[1], n = int(ARGV[2] ?? '40');
	if (name == 'update')
		rj({ ok: true, log: tail_lines(state_dir() + '/update.log', n) });
	else if (name == 'service')
		rj({ ok: true, log: trim(sh_out('logread 2>/dev/null | grep -i sun | tail -n ' + n) ?? '') });
	else
		err('unknown log: ' + name);
}

function act_legacy_force() {
	let onoff = ARGV[1];
	mkdir_p(state_dir());
	if (onoff == 'on') {
		if (legacy_dir() == '')
			err('no legacy v1 install found');
		let f = open(state_dir() + '/force-legacy', 'w');
		f.write('1\n');
		f.close();
		sh_out('/etc/init.d/sunpanel restart >/dev/null 2>&1');
		rj({ ok: true, mode: 'legacy-forced' });
	} else {
		unlink(state_dir() + '/force-legacy');
		sh_out('/etc/init.d/sunpanel restart >/dev/null 2>&1');
		rj({ ok: true, mode: v2_present() ? 'v2' : 'auto' });
	}
}

function act_conf_get() {
	rj({
		ok: true,
		ENABLED: conf_val('ENABLED', '1'),
		PORT: sp_port(),
		HTTPS_PORT: conf_val('HTTPS_PORT', '3003'),
		LISTEN_ADDRESS: conf_val('LISTEN_ADDRESS', '0.0.0.0'),
		TOKEN_EXPIRES: conf_val('TOKEN_EXPIRES', '168'),
		DATA_DIR: data_dir(),
		APP_DIR: app_dir(),
		DOCKER_HOST: conf_val('DOCKER_HOST', ''),
		CHANNEL: conf_val('CHANNEL', 'beta'),
		MIRROR: conf_val('MIRROR', ''),
		PROXY: conf_val('PROXY', '')
	});
}

function act_conf_save() {
	let vals;
	try {
		vals = json(ARGV[1] ?? '{}');
	} catch (e) {
		err('invalid payload');
	}
	if (type(vals) != 'object')
		err('invalid payload');

	// overlay provided values onto the current file, write canonical form
	let cur = read_conf();
	let order = [ 'ENABLED', 'PORT', 'HTTPS_PORT', 'LISTEN_ADDRESS', 'TOKEN_EXPIRES',
		'DATA_DIR', 'APP_DIR', 'DOCKER_HOST', 'CHANNEL', 'MIRROR', 'PROXY' ];
	let lines = [];
	for (let i = 0; i < length(order); i++) {
		let key = order[i];
		let v = (vals[key] != null) ? '' + vals[key] : (cur[key] ?? '');
		push(lines, key + "='" + replace(v, "'", "'\\''") + "'");
	}
	mkdir_p('/etc');
	let f = open(CONF_FILE, 'w');
	f.write('# luci-app-sunpanel configuration (sourced by /etc/init.d/sunpanel)\n');
	for (let i = 0; i < length(lines); i++)
		f.write(lines[i] + '\n');
	f.close();
	rj({ ok: true, saved: true });
}

/* ---------------- main ---------------- */

let action = ARGV[0] ?? '';

switch (action) {
	case 'ping':            act_ping(); break;
	case 'info':            act_info(); break;
	case 'check-update':    act_check_update(); break;
	case 'update-start':    act_update_start(); break;
	case 'update-status':   act_update_status(); break;
	case 'release-import':  act_release_import(); break;
	case 'rollback':        act_rollback(); break;
	case 'release-delete':  act_release_delete(); break;
	case 'conf-render':     act_conf_render(); break;
	case 'logs':            act_logs(); break;
	case 'legacy-force':    act_legacy_force(); break;
	case 'conf-get':        act_conf_get(); break;
	case 'conf-save':       act_conf_save(); break;
	default:
		err('unknown action: ' + action);
}
