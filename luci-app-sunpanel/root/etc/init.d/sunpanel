#!/bin/sh /etc/rc.common

# luci-app-sunpanel -- procd init script for Sun-Panel
#
# Modes (decided at start):
#   1. v2 mode     : <app_dir>/sun-panel exists -> run v2 with conf under
#                    <data_dir>/conf (rendered by confgen.sh if managed).
#   2. legacy mode : v2 binary missing but a legacy v1 install exists
#                    (/usr/sbin/sun-panel + legacy_v1_dir) -> keep serving
#                    v1 untouched until v2 is installed and set up.
#   3. not installed: log a hint and fail; install via LuCI version page.
#
# Configuration: /etc/sunpanel.conf (shell-sourceable KEY='value').

START=99
STOP=10
USE_PROCD=1
NAME=sunpanel

. /usr/share/sunpanel/common.sh

start_service() {
	local enabled app_dir data_dir manage_conf bin

	enabled="$(sp_conf_default ENABLED 1)"
	[ "$enabled" = "1" ] || return 0

	app_dir="$(sp_app_dir)"
	data_dir="$(sp_data_dir)"

	# Force-legacy escape hatch (rollback path created by dispatcher)
	legacy_run=0
	[ -f "$app_dir/.state/force-legacy" ] && legacy_run=1

	bin="$app_dir/sun-panel"

	if [ "$legacy_run" != "1" ] && [ -x "$bin" ] && [ -n "$data_dir" ]; then
		# ---------------- v2 mode ----------------
		mkdir -p "$data_dir/conf" "$data_dir/database" "$data_dir/uploads" \
			"$data_dir/runtime/temp" "$data_dir/custom" "$data_dir/micro_app" \
			"$app_dir/.state"

		if [ ! -f "$data_dir/conf/conf.ini" ]; then
			if ! sh /usr/share/sunpanel/confgen.sh; then
				sp_log "confgen.sh failed, aborting start"
				return 1
			fi
		fi

		sp_log "starting Sun-Panel v2 on port $(sp_port)"
		procd_open_instance
		procd_set_param command "$bin" -config-path "$data_dir/conf"
		local docker_host
		docker_host="$(sp_conf DOCKER_HOST)"
		[ -n "$docker_host" ] && procd_set_param env DOCKER_HOST="$docker_host"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 5
		procd_set_param file /etc/sunpanel.conf
		procd_close_instance
	else
		# ---------------- legacy v1 shim ----------------
		legacy_dir="$(sp_legacy_dir)"
		if [ "$legacy_run" = "1" ]; then
			sp_log "force-legacy marker active"
		elif [ ! -x "$bin" ]; then
			sp_log "v2 binary not installed yet"
		else
			sp_log "v2 present but data_dir empty; refusing v2 start"
		fi

		if [ -n "$legacy_dir" ] && [ -x /usr/sbin/sun-panel ] && [ -f "$legacy_dir/conf.ini" ]; then
			sp_log "starting legacy Sun-Panel v1 from $legacy_dir (migration pending)"
			procd_open_instance
			procd_set_param command /usr/sbin/sun-panel -config-path "$legacy_dir"
			procd_set_param stdout 1
			procd_set_param stderr 1
			procd_set_param respawn 3600 5 5
			procd_set_param file /etc/sunpanel.conf
			procd_close_instance
			return 0
		fi

		sp_log "Sun-Panel not runnable: no v2 binary and no usable v1 install. Install via LuCI -> Services -> Sun-Panel -> Version"
		return 1
	fi
}

reload_service() {
	sp_log "reload: restarting to re-render configuration"
	restart
}

stop_service() {
	sp_log "stopping"
}
